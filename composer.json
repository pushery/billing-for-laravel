{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pushery/billing-for-laravel",
    "description": "Provider-neutral billing for Laravel: subscriptions, invoices, metered usage, dunning, tax and e-invoicing. Stripe-first, on provider-neutral contracts.",
    "keywords": [
        "laravel",
        "billing",
        "subscriptions",
        "payments",
        "stripe",
        "cashier",
        "invoices",
        "e-invoicing",
        "xrechnung",
        "datev",
        "dunning",
        "usage-based-billing",
        "metered-billing",
        "saas"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/pushery/billing-for-laravel",
    "authors": [
        {
            "name": "Pushery",
            "homepage": "https://www.pushery.com"
        }
    ],
    "support": {
        "issues": "https://github.com/pushery/billing-for-laravel/issues",
        "source": "https://github.com/pushery/billing-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/auth": "^13.0",
        "illuminate/broadcasting": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/collections": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/cashier": "^16.0",
        "stripe/stripe-php": "^17.4|^18.0|^19.0|^20.0",
        "symfony/http-kernel": "^7.4|^8.0"
    },
    "require-dev": {
        "horstoeko/zugferd": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.0",
        "livewire/livewire": "^4.3",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-evals": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "2.2.8",
        "rector/rector": "2.6.2",
        "spaze/phpstan-disallowed-calls": "^4.12"
    },
    "suggest": {
        "livewire/livewire": "Required only for the optional account-hub UI — the nine Livewire screens. The billing core (models, webhooks, invoicing, tax, contracts) needs none of it.",
        "horstoeko/zugferd": "Required only to embed the EN 16931 CII XML into a ZUGFeRD/Factur-X hybrid PDF/A-3 via Invoicing\\ZugferdPdfInvoice. The CII and XRechnung XML writers need none of it.",
        "anthropic-ai/sdk": "Required only to score evals with a real judge, which is wired only when ANTHROPIC_API_KEY is set. Deliberately not a dev dependency: without it every eval still runs, the judge-backed expectations are skipped, and no install pays for a client it never calls."
    },
    "autoload": {
        "psr-4": {
            "Pushery\\Billing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pushery\\Billing\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "@php vendor/bin/pest --coverage-clover=build/clover.xml",
        "test:type-coverage": "@php vendor/bin/pest --type-coverage --type-coverage-json=build/types.json --min=100",
        "test:browser": "pest tests/Browser",
        "test:stripe-live": "pest tests/LiveStripe",
        "test:evals": "pest tests/Evals --evals",
        "test:database": "pest --testsuite=Postgres,MySql",
        "analyze": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:test": "pint --test",
        "rector": "rector process",
        "rector:test": "rector process --dry-run",
        "mutate": "pest --mutate --everything --covered-only --min=85 --testsuite=Unit,Feature,Stripe",
        "mutate:detect": "pest --mutate --everything --covered-only --parallel --processes=4 --min=85 --testsuite=Unit,Feature,Stripe",
        "qa": [
            "@format:test",
            "@rector:test",
            "@analyze",
            "@test:type-coverage",
            "@test:coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pushery\\Billing\\BillingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
